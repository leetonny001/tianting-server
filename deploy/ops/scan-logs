#!/usr/bin/env python3
"""日志特征串扫描（AC-OPS-08-13、AC-OPS-10-1、AC-OPS-14-2）：确认工单号、理由、userId、密钥没有进日志。

用法：scan-logs --marker STR [--marker STR ...] [--with-hash] FILE [FILE ...]

--with-hash 同时查特征串 SHA-256 的前 16 位十六进制（密钥类）。命中时列出"文件:行号:特征串序号"并退出码 1；
不打印命中的行内容，也不回显特征串本身：扫描结果可能被贴到工单里，而特征串可能就是密钥。
"""
import argparse
import hashlib
import sys


def scan(paths, needles):
    hits = []
    for path in paths:
        with open(path, encoding="utf-8", errors="replace") as f:
            for no, line in enumerate(f, 1):
                for idx, needle in needles:
                    if needle in line:
                        hits.append(f"{path}:{no}:marker#{idx}")
    return hits


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--marker", action="append", required=True)
    ap.add_argument("--with-hash", action="store_true")
    ap.add_argument("files", nargs="+")
    args = ap.parse_args(argv)
    needles = []
    for i, m in enumerate(args.marker, 1):
        needles.append((i, m))
        if args.with_hash:
            needles.append((i, hashlib.sha256(m.encode()).hexdigest()[:16]))
    hits = scan(args.files, needles)
    for h in hits:
        print(h)
    print(f"扫描 {len(args.files)} 个文件，{len(args.marker)} 个特征串，命中 {len(hits)} 处")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
