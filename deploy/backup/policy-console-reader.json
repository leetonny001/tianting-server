{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::tianting-backups/manifests/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::tianting-backups"],
      "Condition": {"StringLike": {"s3:prefix": ["manifests/*"]}}
    }
  ]
}
