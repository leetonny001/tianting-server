# C2 文件功能的 im-server 配置样例（deploy/FILES-RUNBOOK.md）。只有占位符：密钥由部署机的密钥管理写入，不进仓库、不进聊天。
IM_FILES_ENABLED=1
# 生产必须是 https，否则拒绝启动；只支持路径风格地址
IM_OBJSTORE_ENDPOINT=https://s3.example.internal
IM_OBJSTORE_REGION=us-east-1
IM_OBJSTORE_BUCKET=tianting-chat-private
IM_OBJSTORE_PUBLIC_BUCKET=tianting-chat-public
# 头像的独立域名（https），生产必填
IM_OBJSTORE_PUBLIC_BASE_URL=https://avatars.example.com
# policy-im-server.json 的最小权限凭证。留空，部署时由密钥管理注入
IM_OBJSTORE_ACCESS_KEY=
IM_OBJSTORE_SECRET_KEY=
# 可选：只能增加不能减少的禁止名单
# IM_FILE_BLOCKLIST=/etc/tianting/file-blocklist.txt
