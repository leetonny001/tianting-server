{
  "description": "推送补拉共享行为用例（PRD-live 4.3、4.8 节，四套 SDK 都跑）。按顺序执行 steps，每步之后断言 expect。expect 里没写的 requests、delivered、pushSynced 表示这一步必须为空；没写 cursor 表示不检查。",
  "format": {
    "ops": {
      "subscribe/unsubscribe": "注册或取消 id 对应的订阅者。subscribe 之后不自动进入调度点，由 tick 显式推进，这样同一调度点可以注册多个",
      "tick": "下一个调度点（TS 微任务；其他端的等价调度）。除 subscribe 外每步结束都隐含一次",
      "connect": "auth 成功，ack 的 serverTime 给定。userId 变化时先按 logout 处理",
      "disconnect": "连接断开（不是退出登录）",
      "logout": "退出登录",
      "live": "依次收到实时 push 帧",
      "ack": "当前 pushSync 的应答。没有进行中的请求时必须忽略",
      "ackError": "当前 pushSync 的错误应答",
      "advance": "假时钟前进 ms 毫秒，触发期间到期的定时器"
    },
    "seqRange": "{seqRange:[a,b], ts, idPrefix?} 展开为 pushId=<idPrefix 默认 p><n>、pushSeq=n 的多个帧；expect.delivered 里同样展开，带 replayed",
    "delivered": "每个当前订阅者都按此顺序收到；deliveredTo 按订阅者分别给出",
    "requests": "这一步发出的 pushSync。afterSeq 请求一律带 limit=defaults.limit",
    "config": "persistence=true 的用例只有带持久化的 SDK 跑；sdk-ts 跳过。stored 是预置的持久化内容"
  },
  "defaults": {
    "limit": 100,
    "stashMax": 200,
    "noSeqQueueMax": 500,
    "gapWaitMs": 500,
    "stashFlushMs": 5000,
    "seenMax": 2000,
    "backoffMs": [
      1000,
      2000,
      4000,
      8000,
      16000,
      30000
    ]
  },
  "cases": [
    {"name": "无订阅者，收件箱 1000 条：不发 pushSync，订阅后才翻页", "rule": "C12、C6、C7", "acs": ["AC-PUSH-03-25", "AC-PUSH-03-15", "AC-PUSH-08-8"],
      "steps": [
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"cursor": 0}},
        {"op": "live", "frames": [{"pushId": "p1001", "pushSeq": 1001, "ts": 2000}]},
        {"op": "advance", "ms": 60000},
        {"op": "subscribe", "id": "a"},
        {"op": "tick", "expect": {"requests": [{"afterSeq": 0}]}},
        {"op": "ack", "pushes": [{"seqRange": [1, 100], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [1, 100], "replayed": true}], "requests": [{"afterSeq": 100}], "cursor": 100}},
        {"op": "ack", "pushes": [{"seqRange": [101, 200], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [101, 200], "replayed": true}], "requests": [{"afterSeq": 200}], "cursor": 200}},
        {"op": "ack", "pushes": [{"seqRange": [201, 300], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [201, 300], "replayed": true}], "requests": [{"afterSeq": 300}], "cursor": 300}},
        {"op": "ack", "pushes": [{"seqRange": [301, 400], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [301, 400], "replayed": true}], "requests": [{"afterSeq": 400}], "cursor": 400}},
        {"op": "ack", "pushes": [{"seqRange": [401, 500], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [401, 500], "replayed": true}], "requests": [{"afterSeq": 500}], "cursor": 500}},
        {"op": "ack", "pushes": [{"seqRange": [501, 600], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [501, 600], "replayed": true}], "requests": [{"afterSeq": 600}], "cursor": 600}},
        {"op": "ack", "pushes": [{"seqRange": [601, 700], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [601, 700], "replayed": true}], "requests": [{"afterSeq": 700}], "cursor": 700}},
        {"op": "ack", "pushes": [{"seqRange": [701, 800], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [701, 800], "replayed": true}], "requests": [{"afterSeq": 800}], "cursor": 800}},
        {"op": "ack", "pushes": [{"seqRange": [801, 900], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [801, 900], "replayed": true}], "requests": [{"afterSeq": 900}], "cursor": 900}},
        {"op": "ack", "pushes": [{"seqRange": [901, 1000], "ts": 500}], "hasMore": true, "latestSeq": 1001, "expect": {"delivered": [{"seqRange": [901, 1000], "replayed": true}], "requests": [{"afterSeq": 1000}], "cursor": 1000}},
        {"op": "ack", "pushes": [{"pushId": "p1001", "pushSeq": 1001, "ts": 2000}], "hasMore": false, "latestSeq": 1001, "expect": {"delivered": [{"pushId": "p1001", "replayed": false}], "cursor": 1001, "pushSynced": [1001]}},
        {"op": "advance", "ms": 60000}
      ]
    },
    {"name": "无订阅者时到达 501 条实时帧：一条都不留，订阅后从收件箱补齐，只交付一次", "rule": "C12", "acs": ["AC-PUSH-08-4", "AC-PUSH-08-5"],
      "steps": [
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"cursor": 0}},
        {"op": "live", "frames": [{"seqRange": [1, 501], "ts": 2000}]},
        {"op": "subscribe", "id": "a"},
        {"op": "tick", "expect": {"requests": [{"afterSeq": 0}]}},
        {"op": "ack", "pushes": [{"seqRange": [1, 100], "ts": 2000}], "hasMore": true, "latestSeq": 501, "expect": {"delivered": [{"seqRange": [1, 100], "replayed": false}], "requests": [{"afterSeq": 100}], "cursor": 100}},
        {"op": "ack", "pushes": [{"seqRange": [101, 200], "ts": 2000}], "hasMore": true, "latestSeq": 501, "expect": {"delivered": [{"seqRange": [101, 200], "replayed": false}], "requests": [{"afterSeq": 200}], "cursor": 200}},
        {"op": "ack", "pushes": [{"seqRange": [201, 300], "ts": 2000}], "hasMore": true, "latestSeq": 501, "expect": {"delivered": [{"seqRange": [201, 300], "replayed": false}], "requests": [{"afterSeq": 300}], "cursor": 300}},
        {"op": "ack", "pushes": [{"seqRange": [301, 400], "ts": 2000}], "hasMore": true, "latestSeq": 501, "expect": {"delivered": [{"seqRange": [301, 400], "replayed": false}], "requests": [{"afterSeq": 400}], "cursor": 400}},
        {"op": "ack", "pushes": [{"seqRange": [401, 500], "ts": 2000}], "hasMore": true, "latestSeq": 501, "expect": {"delivered": [{"seqRange": [401, 500], "replayed": false}], "requests": [{"afterSeq": 500}], "cursor": 500}},
        {"op": "ack", "pushes": [{"pushId": "p501", "pushSeq": 501, "ts": 2000}], "hasMore": false, "latestSeq": 501, "expect": {"delivered": [{"pushId": "p501", "replayed": false}], "cursor": 501, "pushSynced": [501]}}
      ]
    },
    {"name": "备份恢复，游标大于最新：重拉，只交付新的，游标回到 latestSeq", "rule": "C8", "acs": ["AC-PUSH-03-10", "AC-PUSH-08-8"],
      "steps": [
        {"op": "subscribe", "id": "a"},
        {"op": "tick"},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [{"seqRange": [1, 100], "ts": 500}], "hasMore": false, "latestSeq": 100, "expect": {"delivered": [{"seqRange": [1, 100], "replayed": true}], "cursor": 100, "pushSynced": [100]}},
        {"op": "disconnect"},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 100}]}},
        {"op": "ack", "pushes": [], "hasMore": false, "latestSeq": 55, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [{"seqRange": [1, 50], "ts": 500}, {"seqRange": [51, 55], "ts": 2000, "idPrefix": "n"}], "hasMore": false, "latestSeq": 55, "expect": {"delivered": [{"seqRange": [51, 55], "replayed": false, "idPrefix": "n"}], "cursor": 55, "pushSynced": [55]}},
        {"op": "live", "frames": [{"pushId": "n56", "pushSeq": 56, "ts": 2000}], "expect": {"delivered": [{"pushId": "n56", "replayed": false}], "cursor": 56}}
      ]
    },
    {"name": "翻页中实时帧到达：200 不抢先，只交付一次", "rule": "C2、C6、C7", "acs": ["AC-PUSH-03-26"],
      "steps": [
        {"op": "subscribe", "id": "a"},
        {"op": "tick"},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [], "hasMore": false, "latestSeq": 41, "expect": {"cursor": 41, "pushSynced": [41]}},
        {"op": "live", "frames": [{"pushId": "p200", "pushSeq": 200, "ts": 2000}]},
        {"op": "advance", "ms": 499},
        {"op": "advance", "ms": 1, "expect": {"requests": [{"afterSeq": 41}]}},
        {"op": "ack", "pushes": [{"seqRange": [42, 141], "ts": 2000}], "hasMore": true, "latestSeq": 200, "expect": {"delivered": [{"seqRange": [42, 141], "replayed": false}], "requests": [{"afterSeq": 141}], "cursor": 141}},
        {"op": "ack", "pushes": [{"seqRange": [142, 200], "ts": 2000}], "hasMore": false, "latestSeq": 200, "expect": {"delivered": [{"seqRange": [142, 200], "replayed": false}], "cursor": 200, "pushSynced": [200]}}
      ]
    },
    {"name": "读快照后才提交的帧先于 ack 到达：42、43 之后交付 44", "rule": "C7、C11", "acs": ["AC-PUSH-03-26"],
      "steps": [
        {"op": "subscribe", "id": "a"},
        {"op": "tick"},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [], "hasMore": false, "latestSeq": 41, "expect": {"cursor": 41, "pushSynced": [41]}},
        {"op": "live", "frames": [{"pushId": "p44", "pushSeq": 44, "ts": 2000}]},
        {"op": "advance", "ms": 500, "expect": {"requests": [{"afterSeq": 41}]}},
        {"op": "ack", "pushes": [{"pushId": "p42", "pushSeq": 42, "ts": 2000}, {"pushId": "p43", "pushSeq": 43, "ts": 2000}], "hasMore": false, "latestSeq": 43, "expect": {"delivered": [{"pushId": "p42", "replayed": false}, {"pushId": "p43", "replayed": false}, {"pushId": "p44", "replayed": false}], "cursor": 44, "pushSynced": [44]}}
      ]
    },
    {"name": "同实例 u1 退出、u2 登录，同一 pushId 各交付一次；内存 SDK 回到 u1 时重新回放", "rule": "账号隔离", "acs": ["AC-PUSH-07-3", "AC-PUSH-07-5"],
      "steps": [
        {"op": "subscribe", "id": "a"},
        {"op": "tick"},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [{"pushId": "shared", "pushSeq": 5, "ts": 2000}], "hasMore": false, "latestSeq": 5, "expect": {"delivered": [{"pushId": "shared", "replayed": false}], "cursor": 5, "pushSynced": [5]}},
        {"op": "live", "frames": [{"pushId": "p9", "pushSeq": 9, "ts": 2000}]},
        {"op": "logout", "expect": {"cursor": null}},
        {"op": "connect", "userId": "u2", "serverTime": 3000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [{"pushId": "shared", "pushSeq": 3, "ts": 2000}], "hasMore": false, "latestSeq": 3, "expect": {"delivered": [{"pushId": "shared", "replayed": true}], "cursor": 3, "pushSynced": [3]}},
        {"op": "logout", "expect": {"cursor": null}},
        {"op": "connect", "userId": "u1", "serverTime": 4000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [{"pushId": "shared", "pushSeq": 5, "ts": 2000}], "hasMore": false, "latestSeq": 5, "expect": {"delivered": [{"pushId": "shared", "replayed": true}], "cursor": 5, "pushSynced": [5]}}
      ]
    },
    {"name": "pending 重播：在线实例按 pushId 丢弃，新实例算旧推送", "rule": "C4、4.4 节", "acs": ["AC-PUSH-03-11"],
      "steps": [
        {"op": "subscribe", "id": "a"},
        {"op": "tick"},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [], "hasMore": false, "latestSeq": 41, "expect": {"cursor": 41, "pushSynced": [41]}},
        {"op": "live", "frames": [{"pushId": "p9", "ts": 1500, "target": "all"}], "expect": {"delivered": [{"pushId": "p9", "replayed": false}], "cursor": 41}},
        {"op": "live", "frames": [{"pushId": "p9", "ts": 1500, "target": "all"}], "expect": {"cursor": 41}}
      ]
    },
    {"name": "pending 重播到崩溃后新启动的实例：replayed=true", "rule": "4.5 节规则 4", "acs": [],
      "steps": [
        {"op": "subscribe", "id": "a"},
        {"op": "tick"},
        {"op": "connect", "userId": "u1", "serverTime": 1600, "expect": {"requests": [{"afterSeq": 0}]}},
        {"op": "ack", "pushes": [], "hasMore": false, "latestSeq": 0, "expect": {"cursor": 0, "pushSynced": [0]}},
        {"op": "live", "frames": [{"pushId": "p9", "ts": 1500, "target": "all"}], "expect": {"delivered": [{"pushId": "p9", "replayed": true}], "cursor": 0}}
      ]
    },
    {"name": "连接中途断开：定时器、单飞、退避都取消，暂存保留到重连后合并", "rule": "C9", "acs": ["AC-PUSH-03-27"],
      "steps": [
        {"op": "subscribe", "id": "a"},
        {"op": "tick"},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 0}], "cursor": 0}},
        {"op": "ack", "pushes": [], "hasMore": false, "latestSeq": 91, "expect": {"cursor": 91, "pushSynced": [91]}},
        {"op": "live", "frames": [{"pushId": "p200", "pushSeq": 200, "ts": 2000}]},
        {"op": "advance", "ms": 500, "expect": {"requests": [{"afterSeq": 91}]}},
        {"op": "ackError", "code": 5000},
        {"op": "advance", "ms": 1000, "expect": {"requests": [{"afterSeq": 91}]}},
        {"op": "ackError", "code": 5000},
        {"op": "advance", "ms": 500},
        {"op": "disconnect"},
        {"op": "advance", "ms": 10000, "expect": {"cursor": 91}},
        {"op": "connect", "userId": "u1", "serverTime": 1000, "expect": {"requests": [{"afterSeq": 91}]}},
        {"op": "ack", "pushes": [{"seqRange": [92, 191], "ts": 2000}], "hasMore": true, "latestSeq": 200, "expect": {"delivered": [{"seqRange": [92, 191], "replayed": false}], "requests": [{"afterSeq": 191}], "cursor": 191}},
        {"op": "ack", "pushes": [{"seqRange": [192, 200], "ts": 2000}], "hasMore": false, "latestSeq": 200, "expect": {"delivered": [{"seqRange": [192, 200], "replayed": false}], "cursor": 200, "pushSynced": [200]}}
      ]
    },
