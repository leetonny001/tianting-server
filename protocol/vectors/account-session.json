      "rule": "规则 5",
      "start": {
        "mode": "account",
        "accessGen": 1,
        "accessExpiresAt": 1800018000000,
        "absoluteExpiresAt": 1825920000000
      },
      "steps": [
        {
          "op": "trigger",
          "source": "timer",
          "nowMs": 1800000000000,
          "expect": {
            "action": "refresh",
            "attempt": 1
          },
          "localGen": 1,
          "inflight": true
        },
        {
          "op": "refreshOk",
          "attempt": 1,
          "tokens": {
            "accessGen": 2,
            "accessExpiresAt": 1800086400000,
            "absoluteExpiresAt": 1825920000000
          },
          "expect": {
            "action": "keepToken"
          },
          "localGen": 2,
          "inflight": false
        }
      ]
    },
